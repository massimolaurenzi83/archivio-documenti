{
  "name": "archivio-documenti",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Caveau digitale personale per documenti: 100% locale, cifrato, con biometria e OCR",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
